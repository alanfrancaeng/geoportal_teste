═════════════════════════════════════════════════════════════════ */
function selectProjectInBI(projectId) {
  currentSelectedProjectId = projectId;
  const o = OBRAS_DATA.find(item => item.id === projectId) || OBRAS_DATA[0];
  const stCfg = STATUS_CONFIG[o.status] || STATUS_CONFIG["Cotação"];

  // Alternar visualização para os detalhes do projeto
  document.getElementById('bi-portfolio-view').classList.remove('active-portfolio');
  document.getElementById('bi-project-details-view').classList.remove('hidden-project');

  // 1. Atualizar Pills Ativas
  document.querySelectorAll('.proj-pill-btn').forEach(btn => btn.classList.remove('active'));
  const activePill = document.getElementById(`pill-btn-${o.id}`);
  if (activePill) activePill.classList.add('active');

  // 2. Atualizar Banner do Projeto
  document.getElementById('bi-proj-code').textContent = o.code;
  document.getElementById('bi-proj-code').style.color = stCfg.color;
  document.getElementById('bi-proj-name').textContent = o.name;
  
  const unitBadge = document.getElementById('bi-proj-unit');
  unitBadge.textContent = o.division;
  unitBadge.className = `project-unit-badge ${o.division.toLowerCase()}`;
  
  document.getElementById('bi-proj-desc').textContent = `${o.area} | Responsável: ${o.coordenador} | Contratada: ${o.contratada}`;
  
  // Status Tag no Banner
  const statusTag = document.getElementById('bi-proj-status-tag');
  statusTag.className = `status-tag ${stCfg.className}`;
  document.getElementById('bi-proj-status-ico').className = `fa-solid ${stCfg.icon}`;
  document.getElementById('bi-proj-status-txt').textContent = o.status;

  // 3. Atualizar 4 KPIs Específicos
  document.getElementById('kpi-proj-orc').textContent = formatMoeda(o.orcamentoAprovado);
  document.getElementById('kpi-proj-med').textContent = formatMoeda(o.realizado);
  
  const percMed = o.orcamentoAprovado > 0 ? ((o.realizado / o.orcamentoAprovado) * 100).toFixed(1) : "0.0";
  document.getElementById('kpi-proj-med-sub').innerHTML = `<i class="fa-solid fa-chart-pie"></i> ${percMed}% consumido`;

  document.getElementById('kpi-proj-comp').textContent = formatMoeda(o.comprometido);
  const percComp = o.orcamentoAprovado > 0 ? ((o.comprometido / o.orcamentoAprovado) * 100).toFixed(1) : "0.0";
  document.getElementById('kpi-proj-comp-sub').innerHTML = `<i class="fa-solid fa-hourglass-half"></i> ${percComp}% comprometido`;

  document.getElementById('kpi-proj-saldo').textContent = formatMoeda(o.saldo);
  const percSaldo = o.orcamentoAprovado > 0 ? ((o.saldo / o.orcamentoAprovado) * 100).toFixed(1) : "100.0";
  document.getElementById('kpi-proj-saldo-sub').innerHTML = `<i class="fa-solid fa-shield-halved"></i> ${percSaldo}% de saldo restante`;

  // 4. Atualizar os 6 Sub-KPIs de Engenharia
  document.getElementById('subkpi-spi').textContent = o.spi;
  document.getElementById('subkpi-health').textContent = o.healthScore;
  document.getElementById('subkpi-health').style.color = o.healthScore === 'Verde' ? '#3fb950' : (o.healthScore === 'Atenção' ? '#f0883e' : '#f85149');
  document.getElementById('subkpi-duracao').textContent = `${o.duracaoDias} dias`;
  document.getElementById('subkpi-periodo').textContent = `${o.inicio} - ${o.fim_previsto}`;
  document.getElementById('subkpi-desvio-fisico').textContent = o.desvioFisico;
  document.getElementById('subkpi-desvio-prazo').textContent = `${o.desvioPrazoDias} dias`;
  document.getElementById('subkpi-contratada').textContent = o.contratada;
  document.getElementById('subkpi-gestor').textContent = `Gestor: ${o.gestor}`;

  // 5. Badges dos Gráficos
  document.getElementById('chart-badge-avanco').textContent = `Medição Físico: ${o.avancoFisico}% (Plan: ${o.avancoPlanejado}%)`;
  document.getElementById('chart-badge-health').textContent = `Health Score: ${o.healthScore}`;

  // 6. Renderizar os Gráficos Específicos
  renderProjectCharts(o);

  // 7. Renderizar Cronograma de Marcos (Milestones)
  renderMilestones(o);

  // 8. Renderizar Tabela de Riscos Específicos
  renderRiscosTable(o);

  // 9. Renderizar Ficha Técnica Completa
  renderFichaDetails(o);
}

/* Gráficos Específicos do Projeto via Chart.js */
