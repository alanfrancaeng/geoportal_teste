    <div class="fp-actions">
      <span id="p-sync" style="font-size:.7rem;color:var(--text-muted);"></span>
      <button class="fp-btn fp-btn-secondary" onclick="loadPlanoDeAcao(true)">
        <i class="fa-solid fa-rotate"></i> Atualizar Planilha
      </button>
      <button class="fp-btn fp-btn-blue" onclick="openPlanoModal()">
        <i class="fa-solid fa-plus"></i> Nova Ação
      </button>
    </div>
  </div>

  <div class="fp-layout">
    <!-- Left nav -->
    <div class="fp-leftnav">
      <div class="fp-nav-sec-title">Projetos</div>
      <button class="fp-nav-btn active" id="pnav-all" onclick="planoSelectAll()">
        <i class="fa-solid fa-layer-group" style="font-size:.8rem;opacity:.7"></i>
        <span class="nb-label">Todos os projetos</span>
      </button>
      <div class="fp-nav-divider"></div>
      <div id="p-nav-list"></div>
    </div>

    <!-- Content -->
    <div class="fp-content">
      <!-- Project info card -->
      <div class="fp-proj-card" id="p-proj-card">
        <div class="fp-proj-icon" style="background:rgba(88,166,255,.1);">📋</div>
        <div class="fp-proj-info">
          <h3 id="p-proj-title">Todos os Projetos — Visão Consolidada</h3>
          <p  id="p-proj-sub">Plano de Ação BATTRE</p>
        </div>
        <div class="fp-proj-meta" id="p-proj-meta"></div>
      </div>

      <!-- Toolbar -->
      <div class="fp-toolbar">
        <i class="fa-solid fa-magnifying-glass" style="color:var(--text-muted);font-size:.82rem;"></i>
        <input class="fp-search" id="p-search" placeholder="Buscar pendência ou responsável..." oninput="renderPlanoTable()">
        <div class="fp-sep"></div>
        <button class="fp-fchip on ft" id="fpf-t" onclick="planoFilter('todos')">Todos</button>
        <button class="fp-fchip"       id="fpf-a" onclick="planoFilter('Atrasado')">🔴 Atrasado</button>
        <button class="fp-fchip"       id="fpf-u" onclick="planoFilter('Urgente')">🟡 Urgente</button>
        <button class="fp-fchip"       id="fpf-p" onclick="planoFilter('Pendente')">🔵 Pendente</button>
        <button class="fp-fchip"       id="fpf-c" onclick="planoFilter('Concluído')">✅ Concluído</button>
      </div>

      <!-- Table -->
      <div class="fp-table-wrap">
        <table class="fp-table">
          <thead><tr>
            <th style="width:30%">Pendência / Atividade</th>
            <th style="width:28%">Ação a Tomar</th>
            <th style="width:11%">Responsável</th>
            <th style="width:11%">Prazo</th>
            <th style="width:10%">Status</th>
            <th style="width:7%">Projeto</th>
            <th style="width:3%"></th>
          </tr></thead>
          <tbody id="p-tbody"></tbody>
        </table>
        <div id="p-empty" class="fp-empty" style="display:none;">
          <div class="fp-empty-icon">📋</div>
          <p>Nenhuma ação com este filtro.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════════════
     ESTOQUE DE MATERIAL — Tela Cheia
════════════════════════════════════════════════ -->
<div id="view-estoque">
  <!-- Topbar -->
  <div class="fp-topbar">
    <div class="fp-topbar-title">
      <i class="fa-solid fa-boxes-stacked" style="color:#3fb950"></i>
      Estoque de Material
    </div>
    <div class="fp-sep"></div>
    <div class="fp-stats" id="e-stats"></div>
    <div class="fp-actions">
      <div class="est-view-toggle">
        <button class="est-view-btn on" id="e-btn-cards" onclick="estoqueView('cards')">
          <i class="fa-solid fa-grip"></i> Cards
        </button>
        <button class="est-view-btn" id="e-btn-table" onclick="estoqueView('table')">
          <i class="fa-solid fa-table"></i> Tabela
        </button>
      </div>
      <span id="e-sync" style="font-size:.7rem;color:var(--text-muted);"></span>
      <button class="fp-btn fp-btn-secondary" onclick="loadEstoque(true)">
        <i class="fa-solid fa-rotate"></i> Atualizar
      </button>
      <button class="fp-btn fp-btn-primary" onclick="openEstModal()">
        <i class="fa-solid fa-plus"></i> Novo Item
      </button>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="fp-toolbar">
    <i class="fa-solid fa-magnifying-glass" style="color:var(--text-muted);font-size:.82rem;"></i>
    <input class="fp-search" id="e-search" placeholder="Buscar material..." oninput="renderEstoque()">
    <span style="margin-left:auto;font-size:.77rem;color:var(--text-muted);" id="e-count"></span>
  </div>

  <!-- Cards (default) -->
  <div class="est-cards-grid" id="e-cards"></div>
  <!-- Table (hidden) -->
  <div class="est-tbl-wrap" id="e-tbl-wrap" style="display:none;">
    <table class="est-tbl">
      <thead><tr>
        <th style="width:35%">Material</th>
        <th style="width:20%">Quantidade</th>
        <th style="width:40%">Descrição</th>
        <th style="width:5%"></th>
      </tr></thead>
      <tbody id="e-tbody"></tbody>
    </table>
  </div>
</div>

<!-- ════ MODAL: Nova Ação ════ -->
<div class="fp-modal-bg" id="pm-bg" onclick="if(event.target===this)closePlanoModal()">
  <div class="fp-modal-box">
    <div class="fp-modal-hdr">
      <h3><i class="fa-solid fa-plus" style="color:#58a6ff;margin-right:6px"></i>Nova Ação</h3>
      <button class="fp-modal-close" onclick="closePlanoModal()">✕</button>
    </div>
    <div class="fp-modal-body">
      <div class="fp-field"><label>Projeto *</label><select id="pm-proj"></select></div>
      <div class="fp-field"><label>Pendência / Atividade *</label><textarea id="pm-pend" rows="2" placeholder="Descreva a pendência..."></textarea></div>
      <div class="fp-field"><label>Ação a Tomar</label><textarea id="pm-acao" rows="2" placeholder="Qual ação será executada?"></textarea></div>
      <div class="fp-field-row">
        <div class="fp-field"><label>Responsável</label><input id="pm-resp" type="text" placeholder="Nome"></div>
        <div class="fp-field"><label>Prazo</label><input id="pm-prazo" type="date"></div>
      </div>
    </div>
    <div class="fp-modal-foot">
      <button class="fp-btn fp-btn-secondary" onclick="closePlanoModal()">Cancelar</button>
      <button class="fp-btn fp-btn-blue"      onclick="savePlanoItem()">Salvar Ação</button>
    </div>
  </div>
</div>

<!-- ════ MODAL: Novo Item Estoque ════ -->
<div class="fp-modal-bg" id="em-bg" onclick="if(event.target===this)closeEstModal()">
  <div class="fp-modal-box">
    <div class="fp-modal-hdr">
      <h3><i class="fa-solid fa-plus" style="color:#3fb950;margin-right:6px"></i>Novo Item de Estoque</h3>
      <button class="fp-modal-close" onclick="closeEstModal()">✕</button>
    </div>
    <div class="fp-modal-body">
      <div class="fp-field"><label>Material *</label><input id="em-mat" type="text" placeholder="Nome do material"></div>
      <div class="fp-field-row">
        <div class="fp-field"><label>Quantidade</label><input id="em-qty" type="text" placeholder="Ex: 16 Bobinas"></div>
        <div class="fp-field"><label>Área/Unidade</label><input id="em-unit" type="text" placeholder="Ex: m², kg"></div>
      </div>
      <div class="fp-field"><label>Descrição / Observação</label><textarea id="em-desc" rows="2" placeholder="Detalhes..."></textarea></div>
    </div>
    <div class="fp-modal-foot">
      <button class="fp-btn fp-btn-secondary" onclick="closeEstModal()">Cancelar</button>
      <button class="fp-btn fp-btn-primary"   onclick="saveEstItem()">Salvar Item</button>
    </div>
  </div>
</div>

</body>
</html>
