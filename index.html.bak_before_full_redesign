// ─── Status helpers ───────────────────────────────────────────────────────
function calcSt(prazo) {
  if (!prazo) return 'Pendente';
  const p = prazo.toString().toLowerCase().trim();
  if (p.includes('conclu')) return 'Conclu\u00eddo';
  const m = prazo.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if (m) {
    const dt = new Date(+m[3], +m[2]-1, +m[1]);
    const today = new Date(); today.setHours(0,0,0,0);
    const days = Math.round((dt - today) / 86400000);
    if (days < 0)  return 'Atrasado';
    if (days <= 3) return 'Urgente';
    return 'Pendente';
  }
  return 'Pendente';
}
function stCls(s) {
  return { Atrasado:'a', Urgente:'u', Pendente:'p', 'Conclu\u00eddo':'c' }[s] || 'p';
}
function stIcon(s) {
  return { Atrasado:'\uD83D\uDD34', Urgente:'\uD83D\uDFE1', Pendente:'\uD83D\uDD35', 'Conclu\u00eddo':'\u2705' }[s] || '\u26AA';
}
function escH(t) {
  return (t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ─── Load plano_acao.json ─────────────────────────────────────────────────
async function loadPlanoDeAcao(force) {
  const info = document.getElementById('p-sync');
  if (info) info.textContent = '\u29f3 Carregando...';

  if (force) { try { await fetch('/api/sync', { cache:'no-store' }); } catch(e) {} }

  let serverData = null;

  // 1. Try JSON
  try {
    const r = await fetch('plano_acao.json?t=' + Date.now(), { cache:'no-store' });
    if (r.ok) serverData = await r.json();
  } catch(e) {}

  // 2. Try SheetJS
  if (!serverData && typeof XLSX !== 'undefined') {
    try {
      const r = await fetch('Plano%20de%20a%C3%A7%C3%A3o.xlsx?t='+Date.now(), { cache:'no-store' });
      if (r.ok) {
        const wb = XLSX.read(await r.arrayBuffer(), { type:'array', cellDates:true });
        serverData = {};
        wb.SheetNames.filter(n => n !== 'Estoque de Material').forEach(name => {
          const rows = XLSX.utils.sheet_to_json(wb.Sheets[name], { defval:'' });
          serverData[name] = rows.map((row, i) => {
            const pend = String(row['Pend\u00eancia']||row['Pendencia']||'').trim();
            const acao = String(row['A\u00e7\u00e3o']||row['Acao']||'').trim();
            const resp = String(row['Respons\u00e1vel']||row['Responsavel']||'').trim();
            let prazo  = row['Prazo'] || '';
            if (prazo instanceof Date) prazo = prazo.toLocaleDateString('pt-BR');
            else prazo = String(prazo).trim();
            return { id: String(i+1), pendencia:pend, acao, responsavel:resp, prazo, status:calcSt(prazo) };
          }).filter(r => r.pendencia);
        });
      }
    } catch(e) { console.warn('[PLANO] SheetJS err:', e); }
  }

  // 3. Load local edits from file
  const localEdits = await loadJsonFile('plano_local.json') || {};

  if (serverData) {
    planoData = {};
    const allProjs = new Set([...Object.keys(serverData), ...Object.keys(localEdits)]);
    allProjs.forEach(proj => {
      const srv  = serverData[proj] || [];
      const loc  = localEdits[proj] || [];
      const sids = new Set(srv.map(r => r.id));
      planoData[proj] = [
        ...srv.map(r => {
          const ov = loc.find(l => l.id === r.id && l._ov);
          return ov ? { ...r, ...ov } : { ...r, status: calcSt(r.prazo) };
        }),
        ...loc.filter(r => !sids.has(r.id))
      ];
    });
    if (info) info.textContent = '\u2705 ' + new Date().toLocaleTimeString('pt-BR');
  } else {
    const saved = await loadJsonFile('plano_local.json');
    planoData = saved || {};
    if (info) info.textContent = saved ? '\uD83D\uDCBE Local' : '\u26A0\uFE0F Sem dados';
  }

  renderPlanoNav();
  renderPlanoStats();
  renderPlanoTable();
}

// ─── Nav sidebar ─────────────────────────────────────────────────────────────
function renderPlanoNav() {
  const nav = document.getElementById('p-nav-list');
  if (!nav) return;
  nav.innerHTML = '';
  Object.keys(planoData).forEach(proj => {
    const items = planoData[proj] || [];
    const na = items.filter(r => r.status==='Atrasado').length;
    const nu = items.filter(r => r.status==='Urgente').length;
    const np = items.filter(r => r.status==='Pendente').length;
    const color = PROJ_COL[proj] || '#58a6ff';
    let badge = '';
    if      (na) badge = `<span class="fp-nav-badge nb-r">${na}\u2191</span>`;
    else if (nu) badge = `<span class="fp-nav-badge nb-y">${nu}</span>`;
    else if (np) badge = `<span class="fp-nav-badge nb-b">${np}</span>`;
    else         badge = `<span class="fp-nav-badge nb-g">\u2713</span>`;
    const btn = document.createElement('button');
    btn.className = 'fp-nav-btn' + (planoProj_===proj ? ' active' : '');
    btn.dataset.proj = proj;
    const short = proj.length > 20 ? proj.slice(0,18)+'\u2026' : proj;
    btn.innerHTML = `<span style="color:${color};font-size:.5rem;\u25cf">\u25cf</span>
      <span class="nb-label">${escH(short)}</span>${badge}`;
    btn.onclick = () => planoSelectProj(proj);
    nav.appendChild(btn);
  });
}

// ─── Global stats chips ───────────────────────────────────────────────────────
function renderPlanoStats() {
  const el = document.getElementById('p-stats');
  if (!el) return;
  const all = Object.values(planoData).flat();
  const c = { Atrasado:0, Urgente:0, Pendente:0, 'Conclu\u00eddo':0 };
  all.forEach(r => { if (c[r.status] !== undefined) c[r.status]++; });
  el.innerHTML = [
    c.Atrasado  ? `<span class="fp-chip chip-a" onclick="planoSelectAll();planoFilter('Atrasado')">\uD83D\uDD34 ${c.Atrasado} Atrasado${c.Atrasado>1?'s':''}</span>` : '',
    c.Urgente   ? `<span class="fp-chip chip-u" onclick="planoSelectAll();planoFilter('Urgente')">\uD83D\uDFE1 ${c.Urgente} Urgente${c.Urgente>1?'s':''}</span>` : '',
    c.Pendente  ? `<span class="fp-chip chip-p" onclick="planoSelectAll();planoFilter('Pendente')">\uD83D\uDD35 ${c.Pendente} Pendente${c.Pendente>1?'s':''}</span>` : '',
    c['Conclu\u00eddo'] ? `<span class="fp-chip chip-c" onclick="planoSelectAll();planoFilter('Conclu\u00eddo')">\u2705 ${c['Conclu\u00eddo']} Conclu\u00eddo${c['Conclu\u00eddo']>1?'s':''}</span>` : ''
  ].join('');
}

// ─── Project selection ────────────────────────────────────────────────────────
function planoSelectAll() {
  planoProj_ = null;
  document.getElementById('pnav-all')?.classList.add('active');
  document.querySelectorAll('#p-nav-list .fp-nav-btn').forEach(b => b.classList.remove('active'));
  updateProjCard(null);
  renderPlanoTable();
}

function planoSelectProj(proj) {
  planoProj_ = proj;
  document.getElementById('pnav-all')?.classList.remove('active');
  document.querySelectorAll('#p-nav-list .fp-nav-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.proj === proj);
  });
  updateProjCard(proj);
  renderPlanoTable();
}

function updateProjCard(proj) {
  const titleEl = document.getElementById('p-proj-title');
  const subEl   = document.getElementById('p-proj-sub');
  const metaEl  = document.getElementById('p-proj-meta');
  if (!titleEl) return;
  if (!proj) {
    titleEl.textContent = 'Todos os Projetos \u2014 Vis\u00e3o Consolidada';
    subEl.textContent   = 'Plano de A\u00e7\u00e3o BATTRE';
    if (metaEl) metaEl.innerHTML = '';
    return;
  }
  titleEl.textContent = proj;
  const obraName = PLANO_TO_OBRA[proj];
  const obra = typeof OBRAS_DATA !== 'undefined' && obraName
    ? OBRAS_DATA.find(o => o.nome === obraName || (o.id||'').includes((obraName||'').split(' ')[0].toLowerCase())) : null;
  if (obra) {
    subEl.textContent = obra.local || obra.tipo || 'Obra BATTRE';
    const stCfg = typeof STATUS_CONFIG !== 'undefined' ? (STATUS_CONFIG[obra.status]||{}) : {};
    if (metaEl) metaEl.innerHTML = `
      <span class="fp-status-pill" style="background:${stCfg.bgColor||'rgba(88,166,255,.12)'};color:${stCfg.color||'#58a6ff'}">${obra.status}</span>
      <button class="fp-geo-btn" onclick="switchAppMode('gis');setTimeout(()=>focusObraOnMap('${obra.id}'),500)">
        <i class="fa-solid fa-map-location-dot"></i> Ver no Mapa
      </button>`;
  } else {
    subEl.textContent = 'Plano de A\u00e7\u00e3o';
    if (metaEl) metaEl.innerHTML = '';
  }
}

function focusObraOnMap(obraId) {
  if (typeof map === 'undefined' || typeof OBRAS_DATA === 'undefined') return;
  const obra = OBRAS_DATA.find(o => o.id === obraId);
  if (obra) map.flyTo([obra.lat, obra.lng], 17, { animate:true, duration:1 });
}

// ─── Filter ───────────────────────────────────────────────────────────────────
function planoFilter(f) {
  planoFilter_ = f;
  const map_ = { todos:'ft', Atrasado:'fa', Urgente:'fu', Pendente:'fp', 'Conclu\u00eddo':'fc' };
  Object.entries(map_).forEach(([opt, cls]) => {
    const btn = document.getElementById('fpf-' + (opt==='todos'?'t':opt==='Conclu\u00eddo'?'c':opt[0].toLowerCase()));
    if (!btn) return;
    btn.classList.toggle('on', opt===f || (f==='todos'&&opt==='todos'));
    btn.classList.toggle(cls, true);
    if (opt===f||f==='todos'&&opt==='todos') btn.classList.add(cls);
    else btn.classList.remove(cls);
  });
  // Simpler re-approach
  ['fpf-t','fpf-a','fpf-u','fpf-p','fpf-c'].forEach(id => {
    const btn = document.getElementById(id);
    if(btn) btn.classList.remove('on','ft','fa','fu','fp','fc');
  });
  const fmap = { todos:['fpf-t','ft'], Atrasado:['fpf-a','fa'], Urgente:['fpf-u','fu'], Pendente:['fpf-p','fp'], 'Conclu\u00eddo':['fpf-c','fc'] };
  const [bid, bcls] = fmap[f] || fmap['todos'];
  const btn = document.getElementById(bid);
  if(btn) btn.classList.add('on', bcls);
  renderPlanoTable();
}

// ─── Render table ─────────────────────────────────────────────────────────────
function renderPlanoTable() {
  const tbody  = document.getElementById('p-tbody');
  const emptyEl = document.getElementById('p-empty');
  if (!tbody) return;
  tbody.innerHTML = '';
  const q = (document.getElementById('p-search')?.value || '').toLowerCase();
  const projs = planoProj_ ? [planoProj_] : Object.keys(planoData);
  let total = 0;

  projs.forEach(proj => {
    let items = planoData[proj] || [];
    if (planoFilter_ !== 'todos') items = items.filter(r => r.status === planoFilter_);
    if (q) items = items.filter(r =>
      (r.pendencia||'').toLowerCase().includes(q) ||
      (r.acao||'').toLowerCase().includes(q) ||
      (r.responsavel||'').toLowerCase().includes(q)
    );
    if (!items.length) return;
    total += items.length;

    if (!planoProj_) {
      const hdr = document.createElement('tr');
      hdr.className = 'fp-grp-row';
      const col = PROJ_COL[proj] || '#58a6ff';
      hdr.innerHTML = `<td colspan="7" style="border-left-color:${col}"><i class="fa-solid fa-hard-hat"></i> ${escH(proj)} <span style="font-weight:400;font-size:.7rem;color:var(--text-muted)">${items.length} a\u00e7\u00e3o${items.length>1?'\u00f5es':''}</span></td>`;
      tbody.appendChild(hdr);
    }
    items.forEach(item => tbody.appendChild(buildPlanoRow(item, proj)));
  });

  if (emptyEl) emptyEl.style.display = total===0 ? 'block' : 'none';
}

// ─── Row builder ──────────────────────────────────────────────────────────────
function buildPlanoRow(item, proj) {
  const sc = stCls(item.status || 'Pendente');
  const tr = document.createElement('tr');
  tr.className = `fp-row row-${sc}`;
  tr.dataset.id = item.id; tr.dataset.proj = proj;
  const resp  = item.responsavel || '';
  const ini   = resp.split('/').map(n => (n.trim()[0]||'?')).join('').slice(0,2).toUpperCase();
  const abg   = AVATAR_COL[resp.split('/')[0].trim()] || '#484f58';
  const shortProj = !planoProj_ ? (proj.length>14?proj.slice(0,12)+'\u2026':proj) : '';
  const projBadge = !planoProj_
    ? `<span style="background:rgba(88,166,255,.1);color:#58a6ff;border-radius:5px;padding:1px 6px;font-size:.67rem;">${escH(shortProj)}</span>` : '';

  tr.innerHTML = `
    <td><div class="fp-editable" contenteditable="true" data-f="pendencia" data-id="${item.id}" data-proj="${proj}" onblur="pCellEdit(this)">${escH(item.pendencia)}</div></td>
    <td><div class="fp-editable" contenteditable="true" data-f="acao"      data-id="${item.id}" data-proj="${proj}" onblur="pCellEdit(this)">${escH(item.acao)}</div></td>
    <td><div style="display:flex;align-items:center;gap:6px;">
      <div class="fp-avatar" style="background:${abg};color:#fff;border-color:${abg};">${ini}</div>
      <div class="fp-editable" contenteditable="true" data-f="responsavel" data-id="${item.id}" data-proj="${proj}" onblur="pCellEdit(this)">${escH(resp)}</div>
    </div></td>
    <td><div class="fp-editable" contenteditable="true" data-f="prazo" data-id="${item.id}" data-proj="${proj}" onblur="pCellEdit(this)">${escH(item.prazo)}</div></td>
    <td><select class="fp-sel s${sc}" data-id="${item.id}" data-proj="${proj}" onchange="pStatusChange(this)">
      ${['Pendente','Urgente','Atrasado','Conclu\u00eddo'].map(s=>`<option value="${s}" ${s===item.status?'selected':''}>${stIcon(s)} ${s}</option>`).join('')}
    </select></td>
    <td>${projBadge}</td>
    <td style="text-align:center;"><button title="Excluir" onclick="delPlanoItem('${proj}','${item.id}')"
      style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:.82rem;padding:3px 7px;border-radius:4px;"
      onmouseover="this.style.color='#f85149'" onmouseout="this.style.color=''">
      <i class="fa-solid fa-trash-can"></i></button></td>`;
  return tr;
}

function pCellEdit(el) {
  const { f, id, proj } = el.dataset;
  const item = planoData[proj]?.find(r => r.id===id);
  if (!item) return;
  item[f] = el.innerText.trim();
  if (f==='prazo') {
    item.status = calcSt(item[f]);
    el.closest('tr').className = `fp-row row-${stCls(item.status)}`;
    renderPlanoNav(); renderPlanoStats();
  }
  persistPlano();
}

function pStatusChange(sel) {
  const { id, proj } = sel.dataset;
  const item = planoData[proj]?.find(r => r.id===id);
  if (!item) return;
  item.status = sel.value; item._ov = true;
  sel.className = `fp-sel s${stCls(sel.value)}`;
  sel.closest('tr').className = `fp-row row-${stCls(sel.value)}`;
  renderPlanoNav(); renderPlanoStats();
  persistPlano();
}

function delPlanoItem(proj, id) {
  if (!confirm('Excluir esta a\u00e7\u00e3o?')) return;
  planoData[proj] = (planoData[proj]||[]).filter(r => r.id!==id);
  persistPlano(); renderPlanoNav(); renderPlanoStats(); renderPlanoTable();
}

async function persistPlano() {
  await saveJsonFile('plano_local.json', planoData);
  localStorage.setItem('battre_plano_bkp', JSON.stringify(planoData));
}

// ─── Plano Modal ──────────────────────────────────────────────────────────────
function openPlanoModal() {
  const bg = document.getElementById('pm-bg'); if (!bg) return;
  const sel = document.getElementById('pm-proj');
  if (sel) sel.innerHTML = Object.keys(planoData).map(p=>`<option>${escH(p)}</option>`).join('');
  if (planoProj_ && sel) sel.value = planoProj_;
  document.getElementById('pm-prazo').value = new Date().toISOString().split('T')[0];
  bg.classList.add('open');
}
function closePlanoModal() { document.getElementById('pm-bg')?.classList.remove('open'); }
function savePlanoItem() {
  const proj  = document.getElementById('pm-proj')?.value||'';
  const pend  = document.getElementById('pm-pend')?.value.trim()||'';
  if (!pend) { alert('Pend\u00eancia \u00e9 obrigat\u00f3ria!'); return; }
  const acao  = document.getElementById('pm-acao')?.value.trim()||'';
  const resp  = document.getElementById('pm-resp')?.value.trim()||(currentUser||'');
  const pr    = document.getElementById('pm-prazo')?.value||'';
  let prazo   = pr;
  if (pr.includes('-')) { const [y,m,d]=pr.split('-'); prazo=`${d}/${m}/${y}`; }
  const item  = { id:'L_'+Date.now(), pendencia:pend, acao, responsavel:resp, prazo, status:calcSt(prazo), _localOnly:true };
  if (!planoData[proj]) planoData[proj]=[];
  planoData[proj].push(item);
  persistPlano(); closePlanoModal();
  ['pm-pend','pm-acao','pm-resp'].forEach(id=>{ const e=document.getElementById(id); if(e)e.value=''; });
  if (planoProj_!==proj) planoSelectProj(proj); else renderPlanoTable();
  renderPlanoNav(); renderPlanoStats();
}

// ════════════════════════════════════════════════════════════════════════════
//  ESTOQUE DE MATERIAL
// ════════════════════════════════════════════════════════════════════════════
async function loadEstoque(force) {
  const info = document.getElementById('e-sync');
  if (info) info.textContent = '\u29f3 Carregando...';
  if (force) { try { await fetch('/api/sync',{cache:'no-store'}); } catch(e){} }

  let serverData = null;

  // Try estoque.json
  try {
    const r = await fetch('estoque.json?t='+Date.now(),{cache:'no-store'});
    if (r.ok) serverData = await r.json();
  } catch(e){}

  // Try SheetJS
  if (!serverData && typeof XLSX !== 'undefined') {
    try {
      const r = await fetch('Plano%20de%20a%C3%A7%C3%A3o.xlsx?t='+Date.now(),{cache:'no-store'});
      if (r.ok) {
        const wb = XLSX.read(await r.arrayBuffer(), {type:'array'});
        const ws = wb.Sheets['Estoque de Material'];
        if (ws) {
          const rows = XLSX.utils.sheet_to_json(ws, {defval:''});
          serverData = rows.map((r,i) => ({
            id: String(i+1),
            material:   String(r['Material']  ||r['material']  ||'').trim(),
            quantidade: String(r['Quantidade'] ||r['quantidade']||'').trim(),
            descricao:  String(r['Descri\u00e7\u00e3o']||r['Descricao']||r['descricao']||'').trim()
          })).filter(r => r.material);
        }
      }
    } catch(e) { console.warn('[EST] SheetJS err:',e); }
  }

  const localEst = await loadJsonFile('estoque_local.json');
  if (serverData) {
    estoqueData = serverData;
    if (localEst) {
      localEst.forEach(le => {
        if (le._deleted) { estoqueData = estoqueData.filter(e=>e.id!==le.id); return; }
        const idx = estoqueData.findIndex(e=>e.id===le.id);
        if (idx>=0) estoqueData[idx] = {...estoqueData[idx],...le};
        else estoqueData.push(le);
      });
    }
    if (info) info.textContent = '\u2705 ' + new Date().toLocaleTimeString('pt-BR');
  } else {
    estoqueData = (localEst||[]).filter(e=>!e._deleted);
    if (info) info.textContent = localEst ? '\uD83D\uDCBE Local' : '\u26A0\uFE0F Sem dados';
  }

  renderEstoque();
}

function estoqueView(v) {
  estView_ = v;
  document.getElementById('e-btn-cards')?.classList.toggle('on', v==='cards');
  document.getElementById('e-btn-table')?.classList.toggle('on', v==='table');
  const cards = document.getElementById('e-cards');
  const tbl   = document.getElementById('e-tbl-wrap');
  if(cards) cards.style.display = v==='cards' ? '' : 'none';
  if(tbl)   tbl.style.display   = v==='table' ? '' : 'none';
  renderEstoque();
}

function renderEstoque() {
  const q = (document.getElementById('e-search')?.value||'').toLowerCase();
  let items = estoqueData.filter(e=>!e._deleted);
  if (q) items = items.filter(e =>
    (e.material||'').toLowerCase().includes(q) ||
    (e.descricao||'').toLowerCase().includes(q)
  );
  const countEl = document.getElementById('e-count');
  if (countEl) countEl.textContent = items.length + ' item' + (items.length!==1?'s':'') + ' em estoque';
  const statsEl = document.getElementById('e-stats');
  if (statsEl) statsEl.innerHTML = `<span class="fp-chip chip-c">${items.length} Materiais</span>`;
  if (estView_==='cards') renderEstCards(items);
  else renderEstTable(items);
}

function renderEstCards(items) {
  const grid = document.getElementById('e-cards');
  if (!grid) return;
  if (!items.length) {
    grid.innerHTML = '<div class="fp-empty" style="grid-column:1/-1"><div class="fp-empty-icon">\uD83D\uDCE6</div><p>Nenhum material encontrado.</p></div>';
    return;
  }
  grid.innerHTML = items.map(it => `
    <div class="est-card" data-id="${it.id}">
      <div class="est-card-name" contenteditable="true" data-f="material" data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;">${escH(it.material)}</div>
      <div class="est-card-qty"  contenteditable="true" data-f="quantidade" data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;">${escH(it.quantidade)}</div>
      <div class="est-card-desc" contenteditable="true" data-f="descricao" data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;">${escH(it.descricao)||'<em style="color:var(--text-muted)">Sem descri\u00e7\u00e3o</em>'}</div>
      <div class="est-card-foot">
        <button onclick="delEstItem('${it.id}')"
          style="background:none;border:1px solid var(--border);border-radius:6px;color:var(--text-muted);cursor:pointer;font-size:.74rem;padding:3px 10px;"
          onmouseover="this.style.color='#f85149';this.style.borderColor='#f85149'" onmouseout="this.style.color='';this.style.borderColor=''">
          <i class="fa-solid fa-trash-can"></i> Remover
        </button>
      </div>
    </div>`).join('');
}

function renderEstTable(items) {
  const tbody = document.getElementById('e-tbody');
  if (!tbody) return;
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="4"><div class="fp-empty"><div class="fp-empty-icon">\uD83D\uDCE6</div><p>Nenhum material.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = items.map(it => `
    <tr class="est-row" data-id="${it.id}">
      <td><div contenteditable="true" data-f="material"   data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;">${escH(it.material)}</div></td>
      <td><div contenteditable="true" data-f="quantidade" data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;font-weight:600;color:#3fb950;">${escH(it.quantidade)}</div></td>
      <td><div contenteditable="true" data-f="descricao"  data-id="${it.id}" onblur="estCellEdit(this)" style="outline:none;">${escH(it.descricao)}</div></td>
      <td style="text-align:center;"><button onclick="delEstItem('${it.id}')" title="Remover"
        style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:.82rem;"
        onmouseover="this.style.color='#f85149'" onmouseout="this.style.color=''">
        <i class="fa-solid fa-trash-can"></i></button></td>
    </tr>`).join('');
}

function estCellEdit(el) {
  const { f, id } = el.dataset;
  const item = estoqueData.find(e => e.id===id);
  if (!item) return;
  item[f] = el.innerText.trim();
  item._edit = true;
  persistEstoque();
}

function delEstItem(id) {
  if (!confirm('Remover este item do estoque?')) return;
  const item = estoqueData.find(e=>e.id===id);
  if (item) item._deleted = true;
  persistEstoque(); renderEstoque();
}

async function persistEstoque() {
  await saveJsonFile('estoque_local.json', estoqueData.filter(e => e._edit||e._deleted||e._localOnly));
  localStorage.setItem('battre_estoque_bkp', JSON.stringify(estoqueData));
}

function openEstModal()  { document.getElementById('em-bg')?.classList.add('open'); }
function closeEstModal() { document.getElementById('em-bg')?.classList.remove('open'); }
function saveEstItem() {
  const mat  = document.getElementById('em-mat')?.value.trim()||'';
  if (!mat) { alert('Nome do material \u00e9 obrigat\u00f3rio!'); return; }
  const qty  = document.getElementById('em-qty')?.value.trim()||'';
  const unit = document.getElementById('em-unit')?.value.trim()||'';
  const desc = document.getElementById('em-desc')?.value.trim()||'';
  estoqueData.push({ id:'L_'+Date.now(), material:mat, quantidade:qty+(unit?' '+unit:''), descricao:desc, _localOnly:true });
  persistEstoque(); closeEstModal();
  ['em-mat','em-qty','em-unit','em-desc'].forEach(id=>{ const e=document.getElementById(id); if(e)e.value=''; });
  renderEstoque();
}

</script>


