function deleteNote(idx) {
  const key = NOTES_KEYS[currentNotesTab];
  const notes = JSON.parse(localStorage.getItem(key) || '[]');
  notes.splice(idx, 1);
  localStorage.setItem(key, JSON.stringify(notes));
  renderNotes();
  updateNotesBadge();
