async function saveJsonFile(filename, data) {
  try {
    const r = await fetch('/api/save?file=' + encodeURIComponent(filename), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json; charset=utf-8' },
      body: JSON.stringify(data, null, 2)
    });
    if (r.ok) { console.log('[SAVE] Arquivo salvo:', filename); return true; }
  } catch(e) { console.warn('[SAVE] Servidor offline, usando localStorage:', e.message); }
  localStorage.setItem('battre_file_' + filename, JSON.stringify(data));
  return false;
}

async function loadJsonFile(filename) {
  try {
    const r = await fetch(filename + '?t=' + Date.now(), { cache: 'no-store' });
    if (r.ok) return await r.json();
  } catch(e) {}
  const ls = localStorage.getItem('battre_file_' + filename);
  return ls ? JSON.parse(ls) : null;
}

