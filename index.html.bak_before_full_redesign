async function sincronizarPlanilhaAutomatica(mostrarAlerta = false) {
  const syncBadge = document.getElementById('sync-status-badge');
  const syncTxt = document.getElementById('sync-status-txt');
  const icoSync = document.getElementById('ico-sync');

  if (icoSync) icoSync.classList.add('fa-spin');
  if (syncBadge) {
    syncBadge.className = 'sync-status-badge syncing';
    if (syncTxt) syncTxt.textContent = 'Buscando atualizações na planilha...';
  }

  let dadosAtualizados = null;
  let origem = '';

  // 1. Tentar acionar API de sync do servidor Python (se ativo)
  try {
    const apiRes = await fetch('/api/sync', { cache: 'no-store' });
    if (apiRes.ok) console.log('[SYNC] API /api/sync executada com sucesso.');
  } catch (e) {}

  // 2. Tentar ler dados_obras.json fresco
  try {
    const jsonRes = await fetch('dados_obras.json?_t=' + Date.now(), { cache: 'no-store' });
    if (jsonRes.ok) {
      const jsonData = await jsonRes.json();
      if (jsonData && jsonData.projetos) {
        dadosAtualizados = jsonData.projetos;
        origem = `dados_obras.json (${jsonData.ultima_atualizacao})`;
      }
    }
  } catch (e) {}

  // 3. Tentar ler diretamente o arquivo Excel via SheetJS
  if (typeof XLSX !== 'undefined') {
    try {
      const xlsxRes = await fetch('BI_PMO_Obras_BATTRE.xlsx?_t=' + Date.now(), { cache: 'no-store' });
      if (xlsxRes.ok) {
        const arrayBuf = await xlsxRes.arrayBuffer();
        const parsedData = processarWorkbookExcel(arrayBuf);
        if (parsedData && Object.keys(parsedData).length > 0) {
          dadosAtualizados = parsedData;
          origem = 'BI_PMO_Obras_BATTRE.xlsx (Leitura Direta)';
        }
      }
    } catch (e) {}
  }

  if (dadosAtualizados) {
    aplicarDadosAtualizados(dadosAtualizados);
    const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (syncBadge) {
      syncBadge.className = 'sync-status-badge synced';
      if (syncTxt) syncTxt.innerHTML = `<i class="fa-solid fa-circle-check" style="color:#3fb950"></i> Sincronizado às ${hora}`;
    }
    if (mostrarAlerta) {
      mostrarToastSync(`Planilha atualizada com sucesso! (${hora})`);
    }
  } else {
    if (syncBadge) {
      syncBadge.className = 'sync-status-badge';
      if (syncTxt) syncTxt.innerHTML = `<i class="fa-solid fa-file-excel" style="color:#58a6ff"></i> Planilha Integrada`;
    }
    if (mostrarAlerta) {
      // Se não conseguiu fetch (ex: file://), abrir seletor manual
      document.getElementById('excel-file-selector').click();
    }
  }

  if (icoSync) icoSync.classList.remove('fa-spin');
}

function sincronizarPlanilhaManual() {
  sincronizarPlanilhaAutomatica(true);
}

function carregarExcelArquivoManual(evt) {
  const file = evt.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    const data = new Uint8Array(e.target.result);
    const parsed = processarWorkbookExcel(data);
    if (parsed) {
      aplicarDadosAtualizados(parsed);
      const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
      const syncBadge = document.getElementById('sync-status-badge');
      const syncTxt = document.getElementById('sync-status-txt');
      if (syncBadge) {
        syncBadge.className = 'sync-status-badge synced';
        if (syncTxt) syncTxt.innerHTML = `<i class="fa-solid fa-circle-check" style="color:#3fb950"></i> Carregado Manualmente (${hora})`;
      }
      mostrarToastSync(`Arquivo '${file.name}' carregado e sincronizado com sucesso!`);
    }
  };
  reader.readAsArrayBuffer(file);
}

