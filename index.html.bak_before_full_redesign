let chartPortAvancoInstance = null;
let chartPortOrcInstance = null;

function switchAppMode(mode) {
  ['view-gis','view-bi','view-plano','view-estoque'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('active-view');
  });
  ['tab-webgis','tab-bi','tab-plano','tab-estoque'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('active');
  });

  if (mode === 'gis') {
    document.getElementById('view-gis')?.classList.add('active-view');
    document.getElementById('tab-webgis')?.classList.add('active');
    setTimeout(() => { if (typeof map !== 'undefined') map.invalidateSize(); }, 200);

  } else if (mode === 'bi') {
    document.getElementById('view-bi')?.classList.add('active-view');
    document.getElementById('tab-bi')?.classList.add('active');
    renderBIProjectPills();
    if (currentSelectedProjectId === 'portfolio') selectPortfolioInBI();
    else selectProjectInBI(currentSelectedProjectId);

  } else if (mode === 'plano') {
    document.getElementById('view-plano')?.classList.add('active-view');
    document.getElementById('tab-plano')?.classList.add('active');
    if (!window._planoLoaded) { loadPlanoDeAcao(false); window._planoLoaded = true; }
    else renderPlanoTable();

  } else if (mode === 'estoque') {
    document.getElementById('view-estoque')?.classList.add('active-view');
    document.getElementById('tab-estoque')?.classList.add('active');
    if (!window._estoqueLoaded) { loadEstoque(false); window._estoqueLoaded = true; }
    else renderEstoque();
  }
}

/* Gera a barra superior com pill da Carteira Geral + 7 Obras Individuais */
