/* Renderiza os gráficos da Carteira Global */
function renderPortfolioCharts() {
  // Gráfico 1: Comparativo de Avanço Físico de Todas as Obras
  const ctxAvanco = document.getElementById('chart-port-avanco').getContext('2d');
  if (chartPortAvancoInstance) chartPortAvancoInstance.destroy();

  const labels = OBRAS_DATA.map(o => o.code);
  const dataReal = OBRAS_DATA.map(o => o.avancoFisico);
  const dataPlan = OBRAS_DATA.map(o => o.avancoPlanejado);

  chartPortAvancoInstance = new Chart(ctxAvanco, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [
        {
          label: 'Avanço Realizado (%)',
          data: dataReal,
          backgroundColor: '#388bfd',
          borderRadius: 6
        },
        {
          label: 'Avanço Planejado (%)',
          data: dataPlan,
          backgroundColor: 'rgba(139, 148, 158, 0.4)',
          borderRadius: 6
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: '#8b949e', font: { size: 10 } } }
      },
      scales: {
        x: { ticks: { color: '#8b949e', font: { size: 10 } }, grid: { display: false } },
        y: { ticks: { color: '#8b949e', font: { size: 10 } }, grid: { color: 'rgba(255,255,255,0.05)' }, min: 0, max: 100 }
      }
    }
  });

  // Gráfico 2: Distribuição Orçamentária por Obra
  const ctxOrc = document.getElementById('chart-port-orcamento').getContext('2d');
  if (chartPortOrcInstance) chartPortOrcInstance.destroy();

  const orcLabels = OBRAS_DATA.filter(o => o.orcamentoAprovado > 0).map(o => `${o.code} (${o.name})`);
  const orcValues = OBRAS_DATA.filter(o => o.orcamentoAprovado > 0).map(o => o.orcamentoAprovado);

  chartPortOrcInstance = new Chart(ctxOrc, {
    type: 'doughnut',
    data: {
      labels: orcLabels,
      datasets: [{
        data: orcValues,
        backgroundColor: ['#58a6ff', '#f85149', '#f0883e', '#e3b341', '#bc8cff', '#39c5cf'],
        borderWidth: 2,
        borderColor: '#161b22'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: '#8b949e', font: { size: 9 }, boxWidth: 10 } },
        tooltip: {
          callbacks: {
            label: function(item) {
              return `${item.label}: ${formatMoeda(item.raw)}`;
            }
          }
        }
      }
    }
  });
}

