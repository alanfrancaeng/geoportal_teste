/* ═════════════════════════════════════════════════════════════════
   3. CRIAÇÃO DE ÍCONES E CAMADAS VETORIAIS (PONTOS & CONTORNOS)
═════════════════════════════════════════════════════════════════ */
function createMarkerIcon(statusName, division) {
  const cfg = STATUS_CONFIG[statusName] || STATUS_CONFIG["Cotação"];
  const borderColor = division === 'AMC' ? 'var(--amc)' : 'var(--etb)';

  return L.divIcon({
    className: 'custom-leaflet-marker',
    html: `
      <div style="
        position: relative;
        width: 30px;
        height: 30px;
        background: ${cfg.color};
        border: 2.5px solid ${borderColor};
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        box-shadow: 0 4px 14px rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      ">
        <i class="fa-solid ${cfg.icon}" style="
          transform: rotate(45deg);
          color: #ffffff;
          font-size: 11px;
        "></i>
      </div>
    `,
    iconSize: [30, 30],
    iconAnchor: [15, 30],
    popupAnchor: [0, -32]
  });
}

// Grupos de camadas
const pointsLayerGroup   = L.layerGroup().addTo(map);
const polygonsLayerGroup = L.layerGroup().addTo(map);

const markersMap  = {};
const polygonsMap = {};

function formatMoeda(val) {
  if (val === 0 || !val) return "R$ 0,00";
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}

function buildPopupHtml(o) {
  const stCfg = STATUS_CONFIG[o.status] || STATUS_CONFIG["Cotação"];
  const unitClass = o.division.toLowerCase();

  let pdfButtons = '';
  if (o.pdfs && o.pdfs.length > 0) {
    o.pdfs.forEach((pdfFile, idx) => {
      const label = o.pdfs.length > 1 ? `Abrir PDF (${idx + 1})` : 'Abrir Documento PDF';
      pdfButtons += `
        <a class="file-btn" href="${encodeURIComponent(pdfFile)}" target="_blank">
          <i class="fa-solid fa-file-pdf" style="color: #f85149"></i>
          <span>${label}</span>
        </a>
      `;
    });
  } else {
    pdfButtons = `
      <div class="file-btn btn-disabled">
        <i class="fa-solid fa-file-pdf"></i>
        <span>PDF não anexado</span>
      </div>
    `;
  }

  return `
    <div class="popup-box">
      <div class="popup-header">
        <div class="popup-title-row">
          <span class="popup-title">${o.name}</span>
          <span class="popup-unit-badge ${unitClass}">${o.division}</span>
        </div>
        <div class="status-tag ${stCfg.className}">
          <div class="pulse-dot"></div>
          <i class="fa-solid ${stCfg.icon}"></i>
          <span>${o.status}</span>
        </div>
      </div>

      <div class="popup-body">
        <div class="popup-info-row">
          <span class="popup-info-label"><i class="fa-solid fa-calendar-play"></i> Início:</span>
          <span class="popup-info-value">${o.inicio}</span>
        </div>
        <div class="popup-info-row">
          <span class="popup-info-label"><i class="fa-solid fa-calendar-check"></i> Fim Previsto:</span>
          <span class="popup-info-value">${o.fim_previsto}</span>
        </div>
        <div class="popup-info-row">
          <span class="popup-info-label"><i class="fa-solid fa-coins"></i> Orçamento:</span>
          <span class="popup-info-value">${formatMoeda(o.orcamentoAprovado)}</span>
        </div>
        <div class="popup-info-row">
          <span class="popup-info-label"><i class="fa-solid fa-chart-line"></i> Avanço Físico:</span>
          <span class="popup-info-value" style="color:#58a6ff">${o.avancoFisico}%</span>
        </div>

        <div class="popup-files">
          <div class="popup-files-title">Documentos & BI do Projeto:</div>
          <button class="file-btn" onclick="openProjectInBI('${o.id}')" style="background:rgba(137,87,229,0.2); border-color:#8957e5; color:#fff;">
            <i class="fa-solid fa-chart-pie" style="color:#bc8cff"></i>
            <span>Ver Análise Completa no BI</span>
          </button>
          ${pdfButtons}
          <a class="file-btn" href="BI_PMO_Obras_BATTRE.xlsx" download>
            <i class="fa-solid fa-file-excel" style="color: #3fb950"></i>
            <span>Planilha PMO (.xlsx)</span>
          </a>
        </div>
      </div>
    </div>
  `;
}

/* ═════════════════════════════════════════════════════════════════
   4. RENDERIZAÇÃO DOS MARCADORES, POLÍGONOS E CARDS NA SIDEBAR
═════════════════════════════════════════════════════════════════ */
let currentDivisionFilter = 'ALL';

function renderMarkersAndList() {
  pointsLayerGroup.clearLayers();
  polygonsLayerGroup.clearLayers();

  const container = document.getElementById('obras-list-container');
  container.innerHTML = '';

  const filtered = OBRAS_DATA.filter(o => {
    if (currentDivisionFilter === 'ALL') return true;
    return o.division === currentDivisionFilter;
  });

  document.getElementById('visible-count').textContent = filtered.length;

  filtered.forEach(o => {
    const stCfg = STATUS_CONFIG[o.status] || STATUS_CONFIG["Cotação"];
    const popupHtml = buildPopupHtml(o);

    // 1. Marcador Pontual
    const marker = L.marker([o.lat, o.lng], {
      icon: createMarkerIcon(o.status, o.division)
    }).bindPopup(popupHtml);

    marker.on('click', () => highlightCard(o.id));
    pointsLayerGroup.addLayer(marker);
    markersMap[o.id] = marker;

    // 2. Polígono de Contorno
    if (o.polygonCoords && o.polygonCoords.length > 0) {
      const polygon = L.polygon(o.polygonCoords, {
        color: stCfg.color,
        weight: 2.5,
        opacity: 0.9,
        fillColor: stCfg.color,
        fillOpacity: 0.25,
        dashArray: o.status === 'Em Andamento' ? null : '4, 4'
      }).bindPopup(popupHtml);

      polygon.on('click', () => highlightCard(o.id));
      polygon.on('mouseover', function() { this.setStyle({ fillOpacity: 0.45, weight: 3.5 }); });
      polygon.on('mouseout', function() { this.setStyle({ fillOpacity: 0.25, weight: 2.5 }); });

      polygonsLayerGroup.addLayer(polygon);
      polygonsMap[o.id] = polygon;
    }

    // 3. Card na Sidebar
    const card = document.createElement('div');
    card.className = `obra-card ${o.division.toLowerCase()}`;
    card.id = `card-${o.id}`;
    card.innerHTML = `
      <div class="obra-header">
        <span class="obra-title" title="${o.name}"><strong>${o.code}</strong> — ${o.name}</span>
        <span class="obra-badge ${o.division.toLowerCase()}">${o.division}</span>
      </div>
      <div class="status-tag ${stCfg.className}">
        <div class="pulse-dot"></div>
        <i class="fa-solid ${stCfg.icon}"></i>
        <span>${o.status}</span>
      </div>
      <div class="obra-details">
        <div class="obra-date-row">
          <i class="fa-solid fa-play" style="color:var(--text-muted); font-size:9px"></i>
          <span>Início: <strong>${o.inicio}</strong></span>
        </div>
        <div class="obra-date-row">
          <i class="fa-solid fa-flag-checkered" style="color:var(--text-muted); font-size:9px"></i>
          <span>Fim Previsto: <strong>${o.fim_previsto}</strong></span>
        </div>
      </div>
      <div class="card-actions">
        <button class="card-btn btn-primary" onclick="focusOnObra('${o.id}')">
          <i class="fa-solid fa-location-crosshairs"></i> Focar
        </button>
        <button class="card-btn" onclick="openProjectInBI('${o.id}')" style="color:#bc8cff;">
          <i class="fa-solid fa-chart-pie"></i> Ver no BI
        </button>
      </div>
    `;

    card.onclick = (e) => {
      if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
        focusOnObra(o.id);
      }
    };

    container.appendChild(card);
  });
}

function highlightCard(id) {
  document.querySelectorAll('.obra-card').forEach(c => c.classList.remove('active-card'));
  const targetCard = document.getElementById(`card-${id}`);
  if (targetCard) {
    targetCard.classList.add('active-card');
    targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
}

function focusOnObra(id) {
  highlightCard(id);
  const o = OBRAS_DATA.find(item => item.id === id);
  if (!o) return;

  const polygon = polygonsMap[id];
  const marker  = markersMap[id];

  if (polygon) {
    map.fitBounds(polygon.getBounds(), { maxZoom: 18, animate: true, padding: [50, 50] });
  } else {
    map.setView([o.lat, o.lng], 18, { animate: true });
  }

  setTimeout(() => {
    if (marker) marker.openPopup();
  }, 400);
}

function filterDivision(div) {
  currentDivisionFilter = div;
  document.querySelectorAll('.div-btn').forEach(b => b.classList.remove('active'));

  if (div === 'ALL') document.getElementById('filter-all').classList.add('active', 'btn-all');
  if (div === 'AMC') document.getElementById('filter-amc').classList.add('active', 'btn-amc');
  if (div === 'ETB') document.getElementById('filter-etb').classList.add('active', 'btn-etb');

  renderMarkersAndList();
  fitAllObras();
}

function toggleLayerGroup(type, isChecked) {
  if (type === 'points') {
    if (isChecked) map.addLayer(pointsLayerGroup);
    else map.removeLayer(pointsLayerGroup);
  }
  if (type === 'polygons') {
    if (isChecked) map.addLayer(polygonsLayerGroup);
    else map.removeLayer(polygonsLayerGroup);
  }
}

function fitAllObras() {
  const points = [];
  OBRAS_DATA.forEach(o => {
    if (currentDivisionFilter === 'ALL' || o.division === currentDivisionFilter) {
      points.push([o.lat, o.lng]);
    }
  });
  if (points.length > 0) {
    map.fitBounds(points, { padding: [60, 60], maxZoom: 17 });
  }
}

function focusDivision(div) {
  filterDivision(div);
  const points = [];
  OBRAS_DATA.filter(o => o.division === div).forEach(o => {
    points.push([o.lat, o.lng]);
  });
  if (points.length > 0) {
    map.fitBounds(points, { padding: [50, 50], maxZoom: 17 });
  }
}

