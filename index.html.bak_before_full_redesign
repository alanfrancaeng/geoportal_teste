/* ═════════════════════════════════════════════════════════════════
   8. MOTOR DE SINCRONIZAÇÃO AUTOMÁTICA COM A PLANILHA EXCEL
═════════════════════════════════════════════════════════════════ */
function normalizarStatusStr(raw) {
  const s = String(raw || '').trim().toLowerCase();
  if (s.includes('andamento')) return 'Em Andamento';
  if (s.includes('atrasad')) return 'Atrasada';
  if (s.includes('cota')) return 'Cotação';
  if (s.includes('contrata')) return 'Contratação';
  if (s.includes('integra')) return 'Integração';
  if (s.includes('projeto') || s.includes('elabora')) return 'Elaboração de Projeto';
  if (s.includes('conclu')) return 'Concluída';
  return String(raw || 'Cotação').trim();
}

function formatarDataExcel(val) {
  if (!val) return '';
  if (val instanceof Date) {
    const d = String(val.getDate()).padStart(2, '0');
    const m = String(val.getMonth() + 1).padStart(2, '0');
    const y = val.getFullYear();
    return `${d}/${m}/${y}`;
  }
  const s = String(val).trim();
  if (s.includes('T')) return s.split('T')[0].split('-').reverse().join('/');
  return s;
}

function mostrarToastSync(msg, isError = false) {
  const toast = document.getElementById('sync-toast');
  const toastMsg = document.getElementById('toast-msg');
  const toastIcon = document.getElementById('toast-icon');
  if (!toast || !toastMsg) return;

  toastMsg.textContent = msg;
  if (isError) {
    toastIcon.className = 'fa-solid fa-triangle-exclamation';
    toastIcon.style.color = '#f85149';
  } else {
    toastIcon.className = 'fa-solid fa-circle-check';
    toastIcon.style.color = '#3fb950';
  }

  toast.classList.add('show');
  setTimeout(() => {
    toast.classList.remove('show');
  }, 4000);
}

function processarWorkbookExcel(arrayBuf) {
  if (typeof XLSX === 'undefined') return null;
  const wb = XLSX.read(arrayBuf, { type: 'array', cellDates: true });
  const result = {};

  const wsExec = wb.Sheets['Visão Executiva'];
  const wsPrazos = wb.Sheets['Prazos e Avanço'];
  const wsPerf = wb.Sheets['Performance'];
  const wsFicha = wb.Sheets['Ficha do Projeto'];
  const wsRiscos = wb.Sheets['Riscos e Ações'];

  if (!wsExec) return null;

  for (let r = 4; r <= 15; r++) {
    const codeCell = wsExec['A' + r];
    if (!codeCell || !codeCell.v) continue;
    const code = String(codeCell.v).trim();
    if (!code.startsWith('BATTRE-')) continue;

    const nome = wsExec['B' + r] ? String(wsExec['B' + r].v).trim() : '';
    const resp = wsExec['C' + r] ? String(wsExec['C' + r].v).trim() : '';
    const rawStatus = wsExec['D' + r] ? String(wsExec['D' + r].v).trim() : '';
