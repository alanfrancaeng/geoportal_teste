/* Renderiza a trilha de marcos do cronograma */
function renderMilestones(o) {
  const container = document.getElementById('bi-milestones-container');
  container.innerHTML = '';
  document.getElementById('chart-badge-milestone-count').textContent = `${o.milestones.length} Marcos Críticos`;

  o.milestones.forEach(m => {
    let iconClass = 'fa-clock';
    let tagText = 'Pendente';
    let tagColor = '#8b949e';
    let tagBg = 'rgba(139, 148, 158, 0.15)';

    if (m.status === 'done') {
      iconClass = 'fa-check';
      tagText = 'Concluído';
      tagColor = '#3fb950';
      tagBg = 'rgba(63, 185, 80, 0.15)';
    } else if (m.status === 'active') {
      iconClass = 'fa-rotate fa-spin';
      tagText = 'Em Andamento';
      tagColor = '#58a6ff';
      tagBg = 'rgba(56, 139, 253, 0.15)';
    } else if (m.status === 'delay') {
      iconClass = 'fa-triangle-exclamation';
      tagText = 'Atrasado';
      tagColor = '#f85149';
      tagBg = 'rgba(248, 81, 73, 0.15)';
    }

    const item = document.createElement('div');
    item.className = 'milestone-item';
    item.innerHTML = `
      <div class="milestone-icon-wrap ${m.status}">
        <i class="fa-solid ${iconClass}"></i>
      </div>
      <div class="milestone-text">
        <div class="milestone-name">${m.name}</div>
        <div class="milestone-date"><i class="fa-solid fa-calendar-day"></i> Marco Previsto: ${m.date}</div>
      </div>
      <span class="milestone-tag" style="background:${tagBg}; color:${tagColor}; border:1px solid ${tagColor}44">${tagText}</span>
    `;
    container.appendChild(item);
  });
}

