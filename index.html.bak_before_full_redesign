//  GRIDSTACK — EDITABLE BI LAYOUT
// ═══════════════════════════════════════════════════════════════════════════════
let gridInstances = {};
let editModeActive = false;

function initGridStack() {
  // Wait for BI tab to be rendered if needed
  setTimeout(_initGridStack, 500);
}

function _initGridStack() {
  // Find chart grid containers in BI
  const containers = document.querySelectorAll('.bi-project-charts-grid, .bi-analysis-grid, .bi-charts-row');
  if (!containers.length) {
    console.log('[GRIDSTACK] No BI grid containers found, will retry when BI tab opens');
    return;
  }
  containers.forEach((container, idx) => {
    if (container.dataset.gsInitialized) return;
    // Wrap children in gs-item divs if not already
    Array.from(container.children).forEach((child, ci) => {
      if (!child.classList.contains('grid-stack-item')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'grid-stack-item';
        wrapper.setAttribute('gs-w', '6');
        wrapper.setAttribute('gs-h', '4');
        wrapper.setAttribute('gs-x', (ci % 2) * 6 + '');
        wrapper.setAttribute('gs-y', Math.floor(ci / 2) * 4 + '');
        const content = document.createElement('div');
        content.className = 'grid-stack-item-content';
        content.style.cssText = 'overflow:hidden;background:#161b22;border:1px solid #30363d;border-radius:12px;';
        child.style.height = '100%';
        child.style.margin = '0';
        child.style.borderRadius = '0';
        child.style.border = 'none';
        content.appendChild(child.cloneNode(true));
        wrapper.appendChild(content);
        child.replaceWith(wrapper);
      }
    });
    container.style.cssText = 'position:relative;';
    try {
      const gs = GridStack.init({
        column: 12,
        cellHeight: 80,
        margin: 8,
        disableDrag: true,
        disableResize: true,
        float: true
      }, container);
      gridInstances['grid_' + idx] = gs;
      container.dataset.gsInitialized = '1';
      console.log('[GRIDSTACK] Initialized grid', idx);
    } catch(e) {
      console.warn('[GRIDSTACK] Init error:', e);
    }
  });
  // Add Edit Mode button to BI header
  addEditModeButton();
}

function addEditModeButton() {
  if (document.getElementById('bi-edit-btn')) return;
  const biHeader = document.querySelector('.bi-header-controls') ||
                   document.querySelector('.bi-controls') ||
                   document.querySelector('#bi-view .view-header') ||
                   document.querySelector('#bi-view header');
  if (!biHeader) {
    // Try to add to the sync button area
    const syncBtn = document.getElementById('sync-btn');
    if (syncBtn) {
      const btn = createEditBtn();
      syncBtn.parentNode.insertBefore(btn, syncBtn);
    }
    return;
  }
  biHeader.appendChild(createEditBtn());
}

function createEditBtn() {
  const btn = document.createElement('button');
  btn.id = 'bi-edit-btn';
  btn.innerHTML = '✏️ Editar Layout';
  btn.style.cssText = 'background:#1f6feb;border:none;border-radius:8px;padding:.5rem 1rem;'+
    'color:#fff;font-size:.85rem;cursor:pointer;font-family:Inter,sans-serif;'+
    'font-weight:600;display:flex;align-items:center;gap:.4rem;margin-left:auto;';
  btn.onclick = toggleEditMode;
  return btn;
}

function toggleEditMode() {
  editModeActive = !editModeActive;
  const btn = document.getElementById('bi-edit-btn');
  Object.values(gridInstances).forEach(gs => {
    if (editModeActive) {
      gs.enableMove(true);
      gs.enableResize(true);
    } else {
      gs.enableMove(false);
      gs.enableResize(false);
      saveBiLayout();
    }
  });
  if (btn) {
    if (editModeActive) {
      btn.innerHTML = '💾 Salvar Layout';
      btn.style.background = '#238636';
      // Add reset button
      let resetBtn = document.getElementById('bi-reset-btn');
      if (!resetBtn) {
        resetBtn = document.createElement('button');
        resetBtn.id = 'bi-reset-btn';
        resetBtn.innerHTML = '↩ Restaurar';
        resetBtn.style.cssText = 'background:#6e7681;border:none;border-radius:8px;padding:.5rem .8rem;'+
          'color:#fff;font-size:.85rem;cursor:pointer;font-family:Inter,sans-serif;margin-left:.5rem;';
        resetBtn.onclick = resetBiLayout;
        btn.parentNode.insertBefore(resetBtn, btn.nextSibling);
      }
    } else {
      btn.innerHTML = '✏️ Editar Layout';
      btn.style.background = '#1f6feb';
      const resetBtn = document.getElementById('bi-reset-btn');
      if(resetBtn) resetBtn.remove();
    }
  }
}

function saveBiLayout() {
  if (!currentUser) return;
  const layouts = {};
  Object.entries(gridInstances).forEach(([key, gs]) => {
    layouts[key] = gs.save();
  });
  localStorage.setItem('battre_' + currentUser + '_bi_layout', JSON.stringify(layouts));
  showToast('Layout salvo para ' + currentUser + '!', '✅');
  console.log('[GRIDSTACK] Layout salvo para', currentUser);
}

function loadBiLayout() {
  if (!currentUser) return;
  const saved = localStorage.getItem('battre_' + currentUser + '_bi_layout');
  if (!saved) return;
  try {
    const layouts = JSON.parse(saved);
    Object.entries(layouts).forEach(([key, layout]) => {
      if (gridInstances[key]) {
        gridInstances[key].load(layout);
      }
    });
    console.log('[GRIDSTACK] Layout carregado para', currentUser);
  } catch(e) {
    console.warn('[GRIDSTACK] Erro ao carregar layout:', e);
  }
}

function resetBiLayout() {
  if (!currentUser) return;
  if (!confirm('Restaurar o layout padrão? Isso apagará suas personalizações.')) return;
  localStorage.removeItem('battre_' + currentUser + '_bi_layout');
  Object.values(gridInstances).forEach(gs => gs.removeAll());
  _initGridStack();
  showToast('Layout restaurado!', '↩');
}

function showToast(msg, icon) {
  const toast = document.getElementById('sync-toast');
  const toastMsg = document.getElementById('toast-msg');
  const toastIcon = document.getElementById('toast-icon');
  if (!toast || !toastMsg) return;
  toastMsg.textContent = msg;
  if(toastIcon && icon) toastIcon.textContent = icon;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

